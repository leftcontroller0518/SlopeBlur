<Project>

  <PropertyGroup>
    <!--
      YMM4 のインストール先（YukkuriMovieMaker4.exe があるフォルダ）。
      末尾の「\」は必須です。環境に合わせて書き換えてください。
      コマンドラインから上書きも可能: msbuild /p:YMM4DirPath="D:\YMM4\"
    -->
    <YMM4DirPath>C:\YMM4\</YMM4DirPath>

    <!--
      fxc.exe（HLSLコンパイラ）のパス。空の場合は Windows SDK から自動検出します。
      明示したい場合: <FxcPath>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\fxc.exe</FxcPath>
    -->
    <FxcPath Condition="'$(FxcPath)' == ''"></FxcPath>
    <WindowsKitBinDir>$(MSBuildProgramFiles32)\Windows Kits\10\bin\</WindowsKitBinDir>
  </PropertyGroup>

</Project>
