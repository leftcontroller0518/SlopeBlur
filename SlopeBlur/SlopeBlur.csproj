<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <RootNamespace>SlopeBlur</RootNamespace>
    <AssemblyName>SlopeBlur</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- HLSL: fxc で .cso にコンパイルし、アセンブリのリソースとして埋め込む -->
  <ItemGroup>
    <HlslShader Include="Shaders\SlopeBlur.hlsl" />
    <Resource Include="Shaders\SlopeBlur.cso" />
  </ItemGroup>

  <Target Name="FindFxc" BeforeTargets="CompileHlslShaders" Condition="'$(FxcPath)' == ''">
    <ItemGroup>
      <_FxcCandidate Include="$(WindowsKitBinDir)*\x64\fxc.exe" />
    </ItemGroup>
    <PropertyGroup>
      <FxcPath>%(_FxcCandidate.FullPath)</FxcPath>
      <FxcPath Condition="'$(FxcPath)' == ''">fxc.exe</FxcPath>
    </PropertyGroup>
  </Target>

  <Target Name="CompileHlslShaders" BeforeTargets="BeforeBuild" Inputs="@(HlslShader)" Outputs="@(HlslShader->'%(RootDir)%(Directory)%(Filename).cso')">
    <Message Importance="high" Text="Compiling HLSL: %(HlslShader.Identity) (fxc: $(FxcPath))" />
    <Exec Command="&quot;$(FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;%(HlslShader.RootDir)%(HlslShader.Directory)%(HlslShader.Filename).cso&quot; &quot;%(HlslShader.FullPath)&quot;" />
  </Target>

  <!-- YMM4 本体の参照（出力にはコピーしない） -->
  <ItemGroup>
    <Reference Include="SharpGen.Runtime">
      <HintPath>$(YMM4DirPath)SharpGen.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpGen.Runtime.COM">
      <HintPath>$(YMM4DirPath)SharpGen.Runtime.COM.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.Direct2D1">
      <HintPath>$(YMM4DirPath)Vortice.Direct2D1.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.Direct3D11">
      <HintPath>$(YMM4DirPath)Vortice.Direct3D11.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.DirectX">
      <HintPath>$(YMM4DirPath)Vortice.DirectX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.Mathematics">
      <HintPath>$(YMM4DirPath)Vortice.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YukkuriMovieMaker">
      <HintPath>$(YMM4DirPath)YukkuriMovieMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YukkuriMovieMaker.Controls">
      <HintPath>$(YMM4DirPath)YukkuriMovieMaker.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YukkuriMovieMaker.Plugin">
      <HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(YMM4DirPath)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ビルド後、YMM4 の user\plugin\SlopeBlur\ にコピー -->
  <Target Name="DeployToYmm4" AfterTargets="Build" Condition="Exists('$(YMM4DirPath)user')">
    <MakeDir Directories="$(YMM4DirPath)user\plugin\$(MSBuildProjectName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(YMM4DirPath)user\plugin\$(MSBuildProjectName)" />
  </Target>

</Project>
